const Y6500: f32 = 3.777028658;

// Planck spectrum integrated into XYZ, then linear sRGB. Dividing by T^4
// leaves the visible fraction/chromaticity per unit bolometric flux.
fn thermal_rgb(temperature:f32)->vec3<f32> {
    let t=clamp(temperature,100.0,1000000.0);
    var xyz=vec3<f32>(0.0);
    for(var i=0u;i<41u;i++) {
        let lambda=0.38+0.01*f32(i);
        let planck=1.0/(pow(lambda,5.0)*(exp(min(80.0,14387.76877/(lambda*t)))-1.0));
        xyz+=CIE[i]*planck;
    }
    xyz/=Y6500*pow(t/6500.0,4.0);
    return max(vec3<f32>(dot(vec3<f32>(3.2406,-1.5372,-0.4986),xyz),
        dot(vec3<f32>(-0.9689,1.8758,0.0415),xyz),
        dot(vec3<f32>(0.0557,-0.2040,1.0570),xyz)),vec3<f32>(0.0));
}
